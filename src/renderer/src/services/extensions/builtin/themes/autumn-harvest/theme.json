{
  "name": "Autumn Harvest",
  "type": "dark",
  "colors": {
    "bg": "#1a1610",
    "surface": "#242018",
    "border": "#3a3428",
    "accent": "#d2691e",
    "text": "#f0e4d0",
    "textSecondary": "#c0a888",
    "textMuted": "#6a5a48",
    "error": "#c85848",
    "warning": "#d4a030",
    "success": "#78a858",
    "info": "#5888b0",
    "scrollbarThumb": "#4a4438",
    "scrollbarThumbHover": "#5a5448",
    "indentGuide": "#302a20",
    "surfaceRaised": "#312d26",
    "hover": "#3e3b34",
    "active": "#4b4842",
    "accentHover": "#d67834",
    "accentActive": "#da8446",
    "errorHover": "#cf6c5e",
    "onAccent": "#ffffff",
    "onError": "#ffffff",
    "borderStrong": "#524c42",
    "editorBg": "#242018",
    "panelBorder": "#3a3428"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line",
        "comment.block"
      ],
      "foreground": "#6a5a48",
      "fontStyle": "italic"
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "foreground": "#a0c878"
    },
    {
      "scope": [
        "constant.numeric",
        "number"
      ],
      "foreground": "#d4a030"
    },
    {
      "scope": [
        "constant.language",
        "constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "foreground": "#c9603a"
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other"
      ],
      "foreground": "#e08040"
    },
    {
      "scope": [
        "keyword.operator",
        "operator"
      ],
      "foreground": "#cd8a4e"
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "function.name"
      ],
      "foreground": "#78b0c8"
    },
    {
      "scope": [
        "support.type",
        "entity.name.type",
        "storage.type",
        "storage.modifier"
      ],
      "foreground": "#e0c070"
    },
    {
      "scope": [
        "entity.name.class",
        "meta.class",
        "type.name"
      ],
      "foreground": "#b58db0"
    },
    {
      "scope": [
        "entity.name.tag",
        "tag"
      ],
      "foreground": "#c85848"
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "attribute"
      ],
      "foreground": "#8fb0a0"
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "foreground": "#d9a97a"
    },
    {
      "scope": "variable.parameter",
      "foreground": "#c06a80"
    },
    {
      "scope": [
        "variable.object.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "foreground": "#d89068"
    },
    {
      "scope": [
        "punctuation",
        "punctuation.definition",
        "punctuation.separator"
      ],
      "foreground": "#a89078"
    },
    {
      "scope": "markup.heading",
      "foreground": "#e08040",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.bold",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.italic",
      "fontStyle": "italic"
    }
  ]
}
