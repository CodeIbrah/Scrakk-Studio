{
  "name": "Cyberpunk 2077",
  "type": "dark",
  "colors": {
    "bg": "#0c0c1e",
    "surface": "#12122a",
    "border": "#2a2a4a",
    "accent": "#fcee0a",
    "text": "#00f0ff",
    "textSecondary": "#7df9ff",
    "textMuted": "#4a6a7a",
    "error": "#ff003c",
    "warning": "#fcee0a",
    "success": "#00ff9f",
    "info": "#00f0ff",
    "scrollbarThumb": "#2a2a4a",
    "scrollbarThumbHover": "#3a3a5a",
    "indentGuide": "#1a1a3a",
    "surfaceRaised": "#202037",
    "hover": "#2e2e44",
    "active": "#3d3d50",
    "accentHover": "#fcf022",
    "accentActive": "#fdf136",
    "errorHover": "#ff1f53",
    "onAccent": "#000000",
    "onError": "#ffffff",
    "borderStrong": "#444460",
    "editorBg": "#12122a",
    "panelBorder": "#2a2a4a"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "foreground": "#4a6a7a",
      "fontStyle": "italic"
    },
    {
      "scope": "string",
      "foreground": "#00ff9f"
    },
    {
      "scope": "constant.numeric",
      "foreground": "#fcee0a"
    },
    {
      "scope": "constant.language",
      "foreground": "#ff003c"
    },
    {
      "scope": "keyword",
      "foreground": "#ff003c"
    },
    {
      "scope": "keyword.control",
      "foreground": "#ff1f53"
    },
    {
      "scope": "keyword.operator",
      "foreground": "#7df9ff"
    },
    {
      "scope": "storage.type",
      "foreground": "#00f0ff"
    },
    {
      "scope": "storage.modifier",
      "foreground": "#fcf022"
    },
    {
      "scope": "entity.name.function",
      "foreground": "#00f0ff"
    },
    {
      "scope": "support.function",
      "foreground": "#00ff9f"
    },
    {
      "scope": "entity.name.class",
      "foreground": "#ff003c"
    },
    {
      "scope": "entity.name.type",
      "foreground": "#ff1f53"
    },
    {
      "scope": "support.class",
      "foreground": "#ff003c"
    },
    {
      "scope": "support.type",
      "foreground": "#00f0ff"
    },
    {
      "scope": "entity.name.tag",
      "foreground": "#00ff9f"
    },
    {
      "scope": "entity.other.attribute-name",
      "foreground": "#fcee0a"
    },
    {
      "scope": "variable",
      "foreground": "#7df9ff"
    },
    {
      "scope": "variable.other",
      "foreground": "#7df9ff"
    },
    {
      "scope": "variable.parameter",
      "foreground": "#fcee0a"
    },
    {
      "scope": "variable.object.property",
      "foreground": "#fcf022"
    },
    {
      "scope": "meta.object-literal.key",
      "foreground": "#fcf022"
    },
    {
      "scope": "support.type.property-name",
      "foreground": "#fcf022"
    },
    {
      "scope": "punctuation",
      "foreground": "#7df9ff"
    },
    {
      "scope": "markup.heading",
      "foreground": "#fcee0a",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.bold",
      "foreground": "#00ff9f",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.italic",
      "foreground": "#00f0ff",
      "fontStyle": "italic"
    }
  ]
}
