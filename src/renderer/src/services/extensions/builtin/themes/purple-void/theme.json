{
  "name": "Purple Void",
  "type": "dark",
  "colors": {
    "bg": "#000000",
    "surface": "#0a0a0a",
    "border": "#1a1a1a",
    "accent": "#a855f7",
    "text": "#ffffff",
    "textPrimary": "#d4d4d4",
    "textSecondary": "#a3a3a3",
    "textMuted": "#737373",
    "error": "#dc2626",
    "warning": "#f59e0b",
    "success": "#10b981",
    "info": "#3b82f6",
    "scrollbarThumb": "#2a2a2a",
    "scrollbarThumbHover": "#3a3a3a",
    "indentGuide": "#1a1a1a",
    "surfaceRaised": "#191919",
    "hover": "#272727",
    "active": "#363636",
    "accentHover": "#b166f8",
    "accentActive": "#b874f8",
    "errorHover": "#e04040",
    "onAccent": "#ffffff",
    "onError": "#ffffff",
    "borderStrong": "#353535",
    "editorBg": "#0a0a0a",
    "panelBorder": "#1a1a1a"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "foreground": "#737373",
      "fontStyle": "italic"
    },
    {
      "scope": "string",
      "foreground": "#34d399"
    },
    {
      "scope": "constant.numeric",
      "foreground": "#f59e0b"
    },
    {
      "scope": "constant.language",
      "foreground": "#a855f7"
    },
    {
      "scope": "keyword",
      "foreground": "#a855f7"
    },
    {
      "scope": "keyword.control",
      "foreground": "#c084fc"
    },
    {
      "scope": "keyword.operator",
      "foreground": "#d4d4d4"
    },
    {
      "scope": "storage.type",
      "foreground": "#c084fc"
    },
    {
      "scope": "storage.modifier",
      "foreground": "#e879f9"
    },
    {
      "scope": "entity.name.function",
      "foreground": "#60a5fa"
    },
    {
      "scope": "support.function",
      "foreground": "#60a5fa"
    },
    {
      "scope": "entity.name.class, entity.name.type, support.class, support.type",
      "foreground": "#f0abfc"
    },
    {
      "scope": "entity.name.tag",
      "foreground": "#f472b6"
    },
    {
      "scope": "entity.other.attribute-name",
      "foreground": "#fbbf24"
    },
    {
      "scope": "variable, variable.other",
      "foreground": "#d4d4d4"
    },
    {
      "scope": "variable.parameter",
      "foreground": "#e879f9"
    },
    {
      "scope": "variable.object.property, meta.object-literal.key, support.type.property-name",
      "foreground": "#38bdf8"
    },
    {
      "scope": "punctuation",
      "foreground": "#a3a3a3"
    },
    {
      "scope": "markup.heading",
      "foreground": "#a855f7",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.bold",
      "foreground": "#c084fc",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.italic",
      "foreground": "#d4d4d4",
      "fontStyle": "italic"
    }
  ]
}
