{
  "name": "Neon City",
  "type": "dark",
  "colors": {
    "bg": "#1a1a2e",
    "surface": "#16213e",
    "border": "#0f3460",
    "accent": "#e94560",
    "text": "#eaeaea",
    "textSecondary": "#b8b8d1",
    "textMuted": "#6a6a8e",
    "error": "#ff2e63",
    "warning": "#ffc93c",
    "success": "#08d9d6",
    "info": "#00fff5",
    "scrollbarThumb": "#0f3460",
    "scrollbarThumbHover": "#1a4a7a",
    "indentGuide": "#1e3a5f",
    "surfaceRaised": "#242e4a",
    "hover": "#323c55",
    "active": "#404961",
    "accentHover": "#eb5870",
    "accentActive": "#ed667d",
    "errorHover": "#ff4776",
    "onAccent": "#ffffff",
    "onError": "#ffffff",
    "borderStrong": "#2c4c73",
    "editorBg": "#16213e",
    "panelBorder": "#0f3460"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "foreground": "#6a6a8e",
      "fontStyle": "italic"
    },
    {
      "scope": "string",
      "foreground": "#08d9d6"
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "foreground": "#ffc93c"
    },
    {
      "scope": [
        "keyword",
        "keyword.control"
      ],
      "foreground": "#e94560"
    },
    {
      "scope": "keyword.operator",
      "foreground": "#00fff5"
    },
    {
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "foreground": "#00fff5"
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "foreground": "#ff2e63"
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "foreground": "#c4b5fd"
    },
    {
      "scope": "entity.name.tag",
      "foreground": "#e94560"
    },
    {
      "scope": "entity.other.attribute-name",
      "foreground": "#08d9d6"
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "foreground": "#eaeaea"
    },
    {
      "scope": "variable.parameter",
      "foreground": "#ffc93c"
    },
    {
      "scope": [
        "variable.object.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "foreground": "#7dd3fc"
    },
    {
      "scope": "punctuation",
      "foreground": "#b8b8d1"
    },
    {
      "scope": "markup.heading",
      "foreground": "#e94560",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.bold",
      "foreground": "#eaeaea",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.italic",
      "foreground": "#b8b8d1",
      "fontStyle": "italic"
    }
  ]
}
