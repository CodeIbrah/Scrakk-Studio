{
  "name": "Sepia",
  "type": "light",
  "colors": {
    "bg": "#f9f5f0",
    "surface": "#f0ebe4",
    "border": "#d8d0c4",
    "accent": "#8b4513",
    "text": "#5c4a3d",
    "textSecondary": "#7a6a5a",
    "textMuted": "#a09080",
    "error": "#a52a2a",
    "warning": "#cd853f",
    "success": "#6b8e23",
    "info": "#4682b4",
    "scrollbarThumb": "#c8c0b4",
    "scrollbarThumbHover": "#a8a094",
    "indentGuide": "#e0d8cc",
    "surfaceRaised": "#f1ece6",
    "hover": "#f2ede7",
    "active": "#f3efe9",
    "accentHover": "#97582b",
    "accentActive": "#a0663d",
    "errorHover": "#b04444",
    "onAccent": "#ffffff",
    "onError": "#ffffff",
    "borderStrong": "#ddd6cb",
    "editorBg": "#f0ebe4",
    "panelBorder": "#d8d0c4"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "foreground": "#a09080",
      "fontStyle": "italic"
    },
    {
      "scope": "string",
      "foreground": "#6b8e23"
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "foreground": "#cd853f"
    },
    {
      "scope": [
        "keyword",
        "keyword.control"
      ],
      "foreground": "#8b4513"
    },
    {
      "scope": "keyword.operator",
      "foreground": "#a52a2a"
    },
    {
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "foreground": "#a0522d"
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "foreground": "#4682b4"
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "foreground": "#b8860b"
    },
    {
      "scope": "entity.name.tag",
      "foreground": "#a52a2a"
    },
    {
      "scope": "entity.other.attribute-name",
      "foreground": "#cd853f"
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "foreground": "#5c4a3d"
    },
    {
      "scope": "variable.parameter",
      "foreground": "#cd853f"
    },
    {
      "scope": [
        "variable.object.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "foreground": "#a09080"
    },
    {
      "scope": "punctuation",
      "foreground": "#7a6a5a"
    },
    {
      "scope": "markup.heading",
      "foreground": "#8b4513",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.bold",
      "foreground": "#5c4a3d",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.italic",
      "foreground": "#7a6a5a",
      "fontStyle": "italic"
    }
  ]
}
