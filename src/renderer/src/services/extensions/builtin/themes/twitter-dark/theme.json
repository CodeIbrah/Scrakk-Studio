{
  "name": "Twitter Dark",
  "type": "dark",
  "colors": {
    "bg": "#000000",
    "surface": "#16181c",
    "surfaceRaised": "#1e2126",
    "border": "#2f3336",
    "borderStrong": "#3e4144",
    "accent": "#eff3f4",
    "accentHover": "#ffffff",
    "accentActive": "#d6d9db",
    "onAccent": "#0f1419",
    "text": "#e7e9ea",
    "textSecondary": "#71767b",
    "textMuted": "#536471",
    "error": "#f4212e",
    "errorHover": "#ff5a66",
    "onError": "#ffffff",
    "warning": "#ffad1f",
    "success": "#00ba7c",
    "info": "#1d9bf0",
    "hover": "#16181c",
    "active": "#1e2126",
    "scrollbarThumb": "#333639",
    "scrollbarThumbHover": "#3e4144",
    "indentGuide": "#1e2126",
    "panelBorder": "#2f3336",
    "editorBg": "#000000",
    "titleBarBg": "#000000",
    "activityBarBg": "#000000",
    "statusBarBg": "#000000",
    "diffAdded": "rgba(0, 186, 124, 0.16)",
    "diffRemoved": "rgba(244, 33, 46, 0.16)",
    "diffModified": "rgba(29, 155, 240, 0.16)"
  },
  "fonts": {
    "ui": {
      "family": "Inter",
      "source": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap",
      "size": "13px",
      "weight": "400",
      "lineHeight": "1.5"
    },
    "editor": {
      "family": "JetBrains Mono",
      "source": "https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap",
      "size": "13px",
      "lineHeight": "1.6"
    },
    "terminal": {
      "family": "JetBrains Mono, monospace",
      "size": "12.5px"
    },
    "heading": {
      "family": "Inter",
      "weight": "600",
      "size": "14px"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line",
        "comment.block"
      ],
      "foreground": "#71767b",
      "fontStyle": "italic"
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "foreground": "#00ba7c"
    },
    {
      "scope": [
        "constant.numeric",
        "number"
      ],
      "foreground": "#ffad1f"
    },
    {
      "scope": [
        "constant.language",
        "constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "foreground": "#ffc861"
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other"
      ],
      "foreground": "#1d9bf0"
    },
    {
      "scope": [
        "keyword.operator",
        "operator"
      ],
      "foreground": "#f91880"
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "function.name"
      ],
      "foreground": "#7856ff"
    },
    {
      "scope": [
        "support.type",
        "entity.name.type",
        "storage.type",
        "storage.modifier"
      ],
      "foreground": "#56c9e0"
    },
    {
      "scope": [
        "entity.name.class",
        "meta.class",
        "type.name"
      ],
      "foreground": "#a78bfa"
    },
    {
      "scope": [
        "entity.name.tag",
        "tag"
      ],
      "foreground": "#f4212e"
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "attribute"
      ],
      "foreground": "#6ee7b7"
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "foreground": "#b3c7d6"
    },
    {
      "scope": "variable.parameter",
      "foreground": "#2ec4b6"
    },
    {
      "scope": [
        "variable.object.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "foreground": "#ff5a7e"
    },
    {
      "scope": [
        "punctuation",
        "punctuation.definition",
        "punctuation.separator"
      ],
      "foreground": "#6e7b8a"
    },
    {
      "scope": "markup.heading",
      "foreground": "#1d9bf0",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.bold",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.italic",
      "fontStyle": "italic"
    }
  ]
}
