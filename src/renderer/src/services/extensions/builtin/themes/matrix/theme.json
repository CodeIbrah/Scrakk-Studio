{
  "name": "Matrix",
  "type": "dark",
  "colors": {
    "bg": "#0d0d0d",
    "surface": "#0a1a0a",
    "border": "#0f2f0f",
    "accent": "#00ff41",
    "text": "#00ff41",
    "textSecondary": "#00cc33",
    "textMuted": "#006622",
    "error": "#ff0040",
    "warning": "#ccff00",
    "success": "#00ff41",
    "info": "#00ccff",
    "scrollbarThumb": "#0f2f0f",
    "scrollbarThumbHover": "#1a4a1a",
    "indentGuide": "#0a2a0a",
    "surfaceRaised": "#192819",
    "hover": "#273527",
    "active": "#364336",
    "accentHover": "#1aff54",
    "accentActive": "#2eff63",
    "errorHover": "#ff1f57",
    "onAccent": "#000000",
    "onError": "#ffffff",
    "borderStrong": "#2c482c",
    "editorBg": "#0a1a0a",
    "panelBorder": "#0f2f0f"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "foreground": "#006622",
      "fontStyle": "italic"
    },
    {
      "scope": "string",
      "foreground": "#00e676"
    },
    {
      "scope": "constant.numeric",
      "foreground": "#ccff00"
    },
    {
      "scope": "constant.language",
      "foreground": "#00ccff"
    },
    {
      "scope": "keyword",
      "foreground": "#00ff41"
    },
    {
      "scope": "keyword.control",
      "foreground": "#00ff88"
    },
    {
      "scope": "keyword.operator",
      "foreground": "#66ff99"
    },
    {
      "scope": "storage.type",
      "foreground": "#00cc33"
    },
    {
      "scope": "storage.modifier",
      "foreground": "#009933"
    },
    {
      "scope": "entity.name.function",
      "foreground": "#00ccff"
    },
    {
      "scope": "support.function",
      "foreground": "#33ddff"
    },
    {
      "scope": "entity.name.class, entity.name.type, support.class, support.type",
      "foreground": "#ccff00"
    },
    {
      "scope": "entity.name.tag",
      "foreground": "#ff0040"
    },
    {
      "scope": "entity.other.attribute-name",
      "foreground": "#00ff88"
    },
    {
      "scope": "variable, variable.other",
      "foreground": "#00cc33"
    },
    {
      "scope": "variable.parameter",
      "foreground": "#66ff99"
    },
    {
      "scope": "variable.object.property, meta.object-literal.key, support.type.property-name",
      "foreground": "#00b8d4"
    },
    {
      "scope": "punctuation",
      "foreground": "#00cc33"
    },
    {
      "scope": "markup.heading",
      "foreground": "#00ff41",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.bold",
      "foreground": "#00ff88",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.italic",
      "foreground": "#00cc33",
      "fontStyle": "italic"
    }
  ]
}
