{
  "name": "Nord Light",
  "type": "light",
  "colors": {
    "bg": "#eceff4",
    "surface": "#e5e9f0",
    "border": "#d8dee9",
    "accent": "#5e81ac",
    "text": "#2e3440",
    "textSecondary": "#4c566a",
    "textMuted": "#7b88a1",
    "error": "#bf616a",
    "warning": "#d08770",
    "success": "#a3be8c",
    "info": "#81a1c1",
    "scrollbarThumb": "#c8ced9",
    "scrollbarThumbHover": "#b8bec9",
    "indentGuide": "#d8dee9",
    "surfaceRaised": "#e7eaf1",
    "hover": "#e8ecf2",
    "active": "#eaedf3",
    "accentHover": "#6e8eb4",
    "accentActive": "#7b98bb",
    "errorHover": "#c7747c",
    "onAccent": "#ffffff",
    "onError": "#ffffff",
    "borderStrong": "#dde2ec",
    "editorBg": "#e5e9f0",
    "panelBorder": "#d8dee9"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "foreground": "#7b88a1",
      "fontStyle": "italic"
    },
    {
      "scope": "string",
      "foreground": "#a3be8c"
    },
    {
      "scope": "constant.numeric",
      "foreground": "#b48ead"
    },
    {
      "scope": "constant.language",
      "foreground": "#81a1c1"
    },
    {
      "scope": "keyword",
      "foreground": "#81a1c1"
    },
    {
      "scope": "keyword.control",
      "foreground": "#5e81ac"
    },
    {
      "scope": "keyword.operator",
      "foreground": "#81a1c1"
    },
    {
      "scope": "storage.type",
      "foreground": "#81a1c1"
    },
    {
      "scope": "storage.modifier",
      "foreground": "#5e81ac"
    },
    {
      "scope": "entity.name.function",
      "foreground": "#88c0d0"
    },
    {
      "scope": "support.function",
      "foreground": "#88c0d0"
    },
    {
      "scope": "entity.name.class",
      "foreground": "#8fbcbb"
    },
    {
      "scope": "entity.name.type",
      "foreground": "#8fbcbb"
    },
    {
      "scope": "support.class",
      "foreground": "#8fbcbb"
    },
    {
      "scope": "support.type",
      "foreground": "#8fbcbb"
    },
    {
      "scope": "entity.name.tag",
      "foreground": "#bf616a"
    },
    {
      "scope": "entity.other.attribute-name",
      "foreground": "#d08770"
    },
    {
      "scope": "variable",
      "foreground": "#2e3440"
    },
    {
      "scope": "variable.other",
      "foreground": "#2e3440"
    },
    {
      "scope": "variable.parameter",
      "foreground": "#4c566a"
    },
    {
      "scope": "variable.object.property",
      "foreground": "#d08770"
    },
    {
      "scope": "meta.object-literal.key",
      "foreground": "#d08770"
    },
    {
      "scope": "support.type.property-name",
      "foreground": "#d08770"
    },
    {
      "scope": "punctuation",
      "foreground": "#4c566a"
    },
    {
      "scope": "markup.heading",
      "foreground": "#5e81ac",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.bold",
      "foreground": "#88c0d0",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.italic",
      "foreground": "#a3be8c",
      "fontStyle": "italic"
    }
  ]
}
