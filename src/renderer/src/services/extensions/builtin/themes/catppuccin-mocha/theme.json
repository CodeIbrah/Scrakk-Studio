{
  "name": "Catppuccin Mocha",
  "type": "dark",
  "colors": {
    "bg": "#1e1e2e",
    "surface": "#181825",
    "border": "#313244",
    "accent": "#cba6f7",
    "text": "#cdd6f4",
    "textSecondary": "#a6adc8",
    "textMuted": "#6c7086",
    "error": "#f38ba8",
    "warning": "#fab387",
    "success": "#a6e3a1",
    "info": "#89b4fa",
    "scrollbarThumb": "#45475a",
    "scrollbarThumbHover": "#585b70",
    "indentGuide": "#313244",
    "iconColor": "var(--text-color)",
    "surfaceRaised": "#262632",
    "hover": "#34343f",
    "active": "#42424c",
    "accentHover": "#d0aff8",
    "accentActive": "#d4b6f8",
    "errorHover": "#f499b2",
    "onAccent": "#000000",
    "onError": "#000000",
    "borderStrong": "#4a4b5a",
    "editorBg": "#181825",
    "panelBorder": "#313244"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "foreground": "#6c7086",
      "fontStyle": "italic"
    },
    {
      "scope": "string",
      "foreground": "#a6e3a1"
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "foreground": "#fab387"
    },
    {
      "scope": [
        "keyword",
        "keyword.control"
      ],
      "foreground": "#cba6f7"
    },
    {
      "scope": "keyword.operator",
      "foreground": "#89dceb"
    },
    {
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "foreground": "#f9e2af"
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "foreground": "#89b4fa"
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "foreground": "#94e2d5"
    },
    {
      "scope": "entity.name.tag",
      "foreground": "#f38ba8"
    },
    {
      "scope": "entity.other.attribute-name",
      "foreground": "#f9e2af"
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "foreground": "#cdd6f4"
    },
    {
      "scope": "variable.parameter",
      "foreground": "#eba0ac"
    },
    {
      "scope": [
        "variable.object.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "foreground": "#89dceb"
    },
    {
      "scope": "punctuation",
      "foreground": "#a6adc8"
    },
    {
      "scope": [
        "markup.heading",
        "markup.bold"
      ],
      "foreground": "#cba6f7",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.italic",
      "foreground": "#a6adc8",
      "fontStyle": "italic"
    }
  ]
}
