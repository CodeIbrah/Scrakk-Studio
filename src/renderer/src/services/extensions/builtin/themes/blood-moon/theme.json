{
  "name": "Blood Moon",
  "type": "dark",
  "colors": {
    "bg": "#1a0a0a",
    "surface": "#2a1515",
    "border": "#4a2525",
    "accent": "#dc143c",
    "text": "#f5deb3",
    "textSecondary": "#cd853f",
    "textMuted": "#6a4a4a",
    "error": "#ff0000",
    "warning": "#ff8c00",
    "success": "#8b0000",
    "info": "#b22222",
    "scrollbarThumb": "#4a2525",
    "scrollbarThumbHover": "#5a3535",
    "indentGuide": "#3a1a1a",
    "surfaceRaised": "#372323",
    "hover": "#443131",
    "active": "#503f3f",
    "accentHover": "#e02c50",
    "accentActive": "#e23e5f",
    "errorHover": "#ff1f1f",
    "onAccent": "#ffffff",
    "onError": "#ffffff",
    "borderStrong": "#603f3f",
    "editorBg": "#2a1515",
    "panelBorder": "#4a2525"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line",
        "comment.block"
      ],
      "foreground": "#6a4a4a",
      "fontStyle": "italic"
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "foreground": "#ff8c00"
    },
    {
      "scope": [
        "constant.numeric",
        "number"
      ],
      "foreground": "#ffd700"
    },
    {
      "scope": [
        "constant.language",
        "constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "foreground": "#e02c50"
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other"
      ],
      "foreground": "#dc143c"
    },
    {
      "scope": [
        "keyword.operator",
        "operator"
      ],
      "foreground": "#cd853f"
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "function.name"
      ],
      "foreground": "#ff6347"
    },
    {
      "scope": [
        "support.type",
        "entity.name.type",
        "storage.type",
        "storage.modifier"
      ],
      "foreground": "#ff4500"
    },
    {
      "scope": [
        "entity.name.class",
        "meta.class",
        "type.name"
      ],
      "foreground": "#d4a05a"
    },
    {
      "scope": [
        "entity.name.tag",
        "tag"
      ],
      "foreground": "#b22222"
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "attribute"
      ],
      "foreground": "#bc8f8f"
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "foreground": "#edb98a"
    },
    {
      "scope": "variable.parameter",
      "foreground": "#fa8072"
    },
    {
      "scope": [
        "variable.object.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "foreground": "#ffb347"
    },
    {
      "scope": [
        "punctuation",
        "punctuation.definition",
        "punctuation.separator"
      ],
      "foreground": "#a3765a"
    },
    {
      "scope": "markup.heading",
      "foreground": "#dc143c",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.bold",
      "foreground": "#e02c50",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.italic",
      "foreground": "#f5deb3",
      "fontStyle": "italic"
    }
  ]
}
