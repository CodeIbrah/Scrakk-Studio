{
  "name": "Material Lighter",
  "type": "light",
  "colors": {
    "bg": "#fafafa",
    "surface": "#f5f5f5",
    "border": "#e0e0e0",
    "accent": "#7c4dff",
    "text": "#546e7a",
    "textSecondary": "#78909c",
    "textMuted": "#90a4ae",
    "error": "#e53935",
    "warning": "#ffb300",
    "success": "#91b859",
    "info": "#6182b8",
    "scrollbarThumb": "#c8c8c8",
    "scrollbarThumbHover": "#a8a8a8",
    "indentGuide": "#e8e8e8",
    "surfaceRaised": "#f6f6f6",
    "hover": "#f6f6f6",
    "active": "#f7f7f7",
    "accentHover": "#895fff",
    "accentActive": "#946dff",
    "errorHover": "#e8514d",
    "onAccent": "#ffffff",
    "onError": "#ffffff",
    "borderStrong": "#e4e4e4",
    "editorBg": "#f5f5f5",
    "panelBorder": "#e0e0e0"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "foreground": "#90a4ae",
      "fontStyle": "italic"
    },
    {
      "scope": "string",
      "foreground": "#91b859"
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "foreground": "#f76d47"
    },
    {
      "scope": [
        "keyword",
        "keyword.control"
      ],
      "foreground": "#7c4dff"
    },
    {
      "scope": "keyword.operator",
      "foreground": "#39adb5"
    },
    {
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "foreground": "#b47cff"
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "foreground": "#6182b8"
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "foreground": "#ffb62c"
    },
    {
      "scope": "entity.name.tag",
      "foreground": "#e53935"
    },
    {
      "scope": "entity.other.attribute-name",
      "foreground": "#f76d47"
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "foreground": "#e53935"
    },
    {
      "scope": "variable.parameter",
      "foreground": "#f76d47"
    },
    {
      "scope": [
        "variable.object.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "foreground": "#39adb5"
    },
    {
      "scope": "punctuation",
      "foreground": "#78909c"
    },
    {
      "scope": "markup.heading",
      "foreground": "#7c4dff",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.bold",
      "foreground": "#546e7a",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.italic",
      "foreground": "#78909c",
      "fontStyle": "italic"
    }
  ]
}
