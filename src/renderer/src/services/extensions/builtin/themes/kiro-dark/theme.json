{
  "name": "Kiro Dark",
  "type": "dark",
  "colors": {
    "bg": "#19161d",
    "surface": "#211d25",
    "surfaceRaised": "#28242e",
    "border": "#4a464f",
    "borderStrong": "#5a5560",
    "accent": "#b080ff",
    "accentHover": "#c2a0fd",
    "accentActive": "#9e61ff",
    "onAccent": "#ffffff",
    "text": "#ffffff",
    "textSecondary": "#c1bec6",
    "textMuted": "#938f9b",
    "error": "#ff8080",
    "errorHover": "#ff9a9a",
    "onError": "#19161d",
    "warning": "#ffcf99",
    "success": "#80ffb5",
    "info": "#8dc8fb",
    "hover": "#352f3d",
    "active": "#3d3746",
    "scrollbarThumb": "#3d3746",
    "scrollbarThumbHover": "#4a464f",
    "indentGuide": "#302a38",
    "panelBorder": "#4a464f",
    "editorBg": "#211d25",
    "titleBarBg": "#19161d",
    "statusBarBg": "#211d25",
    "activityBarBg": "#28242e",
    "diffAdded": "rgba(128, 255, 181, 0.13)",
    "diffRemoved": "rgba(255, 128, 128, 0.13)",
    "diffModified": "rgba(176, 128, 255, 0.13)"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line",
        "comment.block"
      ],
      "foreground": "#938f9b",
      "fontStyle": "italic"
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "foreground": "#80ffb5"
    },
    {
      "scope": [
        "constant.numeric",
        "number"
      ],
      "foreground": "#ffafd1"
    },
    {
      "scope": [
        "constant.language",
        "constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "foreground": "#ff8080"
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other"
      ],
      "foreground": "#e2d3fe"
    },
    {
      "scope": [
        "keyword.operator",
        "operator"
      ],
      "foreground": "#afb6ff"
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "function.name"
      ],
      "foreground": "#8dc8fb"
    },
    {
      "scope": [
        "support.type",
        "entity.name.type",
        "storage.type",
        "storage.modifier"
      ],
      "foreground": "#ffcf99"
    },
    {
      "scope": [
        "entity.name.class",
        "meta.class",
        "type.name"
      ],
      "foreground": "#ff80b5"
    },
    {
      "scope": [
        "entity.name.tag",
        "tag"
      ],
      "foreground": "#bddffd"
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "attribute"
      ],
      "foreground": "#fff2b3"
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "foreground": "#80f4ff"
    },
    {
      "scope": "variable.parameter",
      "foreground": "#aff8ff"
    },
    {
      "scope": [
        "variable.object.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "foreground": "#808aff"
    },
    {
      "scope": [
        "punctuation",
        "punctuation.definition",
        "punctuation.separator"
      ],
      "foreground": "#c1bec6"
    },
    {
      "scope": "markup.heading",
      "foreground": "#e2d3fe",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.bold",
      "foreground": "#c2a0fd",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.italic",
      "foreground": "#8dc8fb",
      "fontStyle": "italic"
    }
  ]
}
