{
  "name": "Arctic Frost",
  "type": "dark",
  "colors": {
    "bg": "#0c1520",
    "surface": "#121e2c",
    "border": "#1e3040",
    "accent": "#88c0d0",
    "text": "#e5f0f8",
    "textSecondary": "#a8c0d0",
    "textMuted": "#506878",
    "error": "#bf616a",
    "warning": "#ebcb8b",
    "success": "#a3be8c",
    "info": "#81a1c1",
    "scrollbarThumb": "#2e4050",
    "scrollbarThumbHover": "#3e5060",
    "indentGuide": "#182838",
    "surfaceRaised": "#202c39",
    "hover": "#2e3945",
    "active": "#3d4652",
    "accentHover": "#94c6d5",
    "accentActive": "#9dcbd8",
    "errorHover": "#c7747c",
    "onAccent": "#000000",
    "onError": "#ffffff",
    "borderStrong": "#394957",
    "editorBg": "#121e2c",
    "panelBorder": "#1e3040"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line",
        "comment.block"
      ],
      "foreground": "#506878",
      "fontStyle": "italic"
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "foreground": "#a3be8c"
    },
    {
      "scope": [
        "constant.numeric",
        "number"
      ],
      "foreground": "#b48ead"
    },
    {
      "scope": [
        "constant.language",
        "constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "foreground": "#d08770"
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other"
      ],
      "foreground": "#88c0d0"
    },
    {
      "scope": [
        "keyword.operator",
        "operator"
      ],
      "foreground": "#5aa9c9"
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "function.name"
      ],
      "foreground": "#81a1c1"
    },
    {
      "scope": [
        "support.type",
        "entity.name.type",
        "storage.type",
        "storage.modifier"
      ],
      "foreground": "#8fbcbb"
    },
    {
      "scope": [
        "entity.name.class",
        "meta.class",
        "type.name"
      ],
      "foreground": "#c7d982"
    },
    {
      "scope": [
        "entity.name.tag",
        "tag"
      ],
      "foreground": "#bf616a"
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "attribute"
      ],
      "foreground": "#7fb4d8"
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "foreground": "#c6a6e0"
    },
    {
      "scope": "variable.parameter",
      "foreground": "#d18aa0"
    },
    {
      "scope": [
        "variable.object.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "foreground": "#ebcb8b"
    },
    {
      "scope": [
        "punctuation",
        "punctuation.definition",
        "punctuation.separator"
      ],
      "foreground": "#6b7c8c"
    },
    {
      "scope": "markup.heading",
      "foreground": "#88c0d0",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.bold",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.italic",
      "fontStyle": "italic"
    }
  ]
}
